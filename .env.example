# Токен отдельного тестового бота из BotFather
BOT_TOKEN=
OWNER_ID=123456789
GROUP_ID=-1001234567890

# Themes

# ID темы группы для приветствия новых участников группы.
# Поле должно быть либо определено со значением, либо оставаться закомментированным, иначе при старте упадет с ошибкой pydantic.ValidationError
#  WELCOME_THEME_ID=

# Чат для уведомлений о запуске и остановке. Без настройки уведомления выключены.
STATUS_CHAT_ID=-5235809404
# Каждый указывает своё имя в локальном .env
INSTANCE_NAME=Влад      

# Путь относительно корня проекта
DATABASE_PATH=data/bot.sqlite3

# Общая подписка для Docker, передаётся вместе с .env
PROXY_SUBSCRIPTION_URL=
# Для запуска без Docker при необходимости:
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:7890
